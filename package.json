{
  "name": "doc-preview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/doc-preview",
    "dev": "npm run dev -w examples/demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:offline": "node scripts/check-offline.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "smoke": "npm run build -w examples/demo && node scripts/smoke.mjs",
    "smoke:offline": "npm run build -w examples/demo && node scripts/smoke.mjs --offline",
    "verify": "npm run check:offline && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^5.0.0"
  }
}
